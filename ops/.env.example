PRIVY_APP_ID=your-privy-app-id-here
MONGO_ROOT_USERNAME=duelme
MONGO_ROOT_PASSWORD=change-me-to-a-strong-password

# -- Dev-only testnet faucet ---------------------------------------------------
# The /api/v1/faucet/claim endpoint sends 0.001 ETH + 100 MockUSDT from
# FAUCET_PRIVATE_KEY to any authenticated user, once per wallet. Enable only on
# dev hosts. Production compose hardcodes `FAUCET_ENABLED=false` as a
# defense-in-depth kill switch — do NOT remove that hardcoded value from
# ops/docker-compose.prod.yml.
#
# SECURITY: use a DEDICATED hot wallet. Never reuse a key that holds mainnet
# funds — if the dev host is compromised, the key is gone.
#FAUCET_ENABLED=true
#FAUCET_PRIVATE_KEY=your-dev-hot-wallet-private-key-hex
