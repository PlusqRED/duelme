dev.duelme.pro {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /swagger-ui/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /v3/api-docs* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
