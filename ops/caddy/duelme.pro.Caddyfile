duelme.pro {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.privy.io https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.privy.io wss://*.privy.io https://*.rpc.privy.systems https://sepolia-rollup.arbitrum.io https://arb1.arbitrum.io https://gateway.tenderly.co https://*.drpc.org https://explorer-api.walletconnect.com wss://relay.walletconnect.com wss://relay.walletconnect.org wss://www.walletlink.org; frame-src https://*.privy.io https://verify.walletconnect.com https://verify.walletconnect.org https://challenges.cloudflare.com; img-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'"
		-Server
		-X-Powered-By
	}

	# A Rybbit session-replay batch opens with a snapshot of the whole page, which can run
	# past the 1MB every other request is held to; the backend takes up to 10MB.
	@rybbitReplay path /t/session-replay/record/*
	request_body @rybbitReplay {
		max_size 10MB
	}

	@notRybbitReplay not path /t/session-replay/record/*
	request_body @notRybbitReplay {
		max_size 1MB
	}

	handle /api/v1/swagger-ui* {
		respond "Not Found" 404
	}

	handle /api/v1/docs* {
		respond "Not Found" 404
	}

	handle /api/v1/v3/api-docs* {
		respond "Not Found" 404
	}

	# Rybbit analytics (ops/rybbit): only the paths its tracker script calls, mapped onto the
	# backend's /api. The rest of that API (accounts, sites, the stored data) answers on
	# stats.duelme.pro alone, behind its password.
	@rybbit path /t/script.js /t/replay.js /t/metrics.js /t/track /t/identify /t/site/tracking-config/* /t/session-replay/record/*
	handle @rybbit {
		uri path_regexp ^/t/ /api/
		# Rybbit reads the visitor's IP from X-Real-IP, then CF-Connecting-IP, before the
		# X-Forwarded-For Caddy writes; a visitor could send either, so they are set here.
		reverse_proxy 127.0.0.1:3030 {
			header_up X-Real-IP {remote_host}
			header_up -CF-Connecting-IP
		}
	}

	handle /t/* {
		respond "Not Found" 404
	}

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		reverse_proxy 127.0.0.1:3002
	}
}
