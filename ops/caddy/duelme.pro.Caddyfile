duelme.pro {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.privy.io https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.privy.io wss://*.privy.io https://*.rpc.privy.systems https://sepolia-rollup.arbitrum.io https://arb1.arbitrum.io https://gateway.tenderly.co https://*.drpc.org https://explorer-api.walletconnect.com wss://relay.walletconnect.com wss://relay.walletconnect.org wss://www.walletlink.org; frame-src https://*.privy.io https://verify.walletconnect.com https://verify.walletconnect.org https://challenges.cloudflare.com; img-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'"
		-Server
		-X-Powered-By
	}

	# The tracker under /t/ and the body limits: ops/caddy/rybbit-tracker.caddy.
	import /etc/caddy/rybbit-tracker.caddy

	handle /api/v1/swagger-ui* {
		respond "Not Found" 404
	}

	handle /api/v1/docs* {
		respond "Not Found" 404
	}

	handle /api/v1/v3/api-docs* {
		respond "Not Found" 404
	}

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		reverse_proxy 127.0.0.1:3002
	}
}
