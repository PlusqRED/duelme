# DuelMe Mini App configuration. Copy to .env.local and fill in.

# TON Network: "mainnet" or "testnet"
NEXT_PUBLIC_TON_NETWORK=testnet

# Deployed DuelMe contract address (TON friendly format, EQ.../UQ...)
NEXT_PUBLIC_DUELME_ADDRESS=EQAA_REPLACE_WITH_DEPLOYED_ADDRESS

# Toncenter RPC endpoint (rate-limited; use your API key for production).
NEXT_PUBLIC_TONCENTER_URL=https://testnet.toncenter.com/api/v2/jsonRPC
NEXT_PUBLIC_TONCENTER_API_KEY=

# TON Connect manifest URL — must be a public HTTPS URL returning JSON.
# Defaults to the local /tonconnect-manifest.json served by Next.js.
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://duelme.example.com/tonconnect-manifest.json

# Telegram bot username (without the @) for share-link composition.
NEXT_PUBLIC_TG_BOT_USERNAME=duelme_bot

# Mini App short name (the suffix in t.me/<bot>/<short>) used for deep links.
NEXT_PUBLIC_TG_APP_SHORT_NAME=play
